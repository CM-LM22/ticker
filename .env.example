# Passwort fuer die Oberflaeche. Ohne diese Variable ist in der
# Produktion keine Seite erreichbar (bewusst: lieber geschlossen als
# unbemerkt offen). Lang und zufaellig waehlen, es gibt keine
# Sperre nach zu vielen Fehlversuchen.
# Ein Wechsel macht alle bestehenden Anmeldungen ungueltig.
APP_PASSWORD=""

# SEC verlangt einen aussagekraeftigen User-Agent mit Kontakt-E-Mail.
# Ohne ihn antwortet EDGAR mit HTTP 403.
SEC_USER_AGENT="ticker-alerts/0.1 (kontakt@example.com)"

# Neon Postgres, ab Slice 1
DATABASE_URL=""

# Telegram, ab Slice 2
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Earnings-Kalender und Ratings, ab Slice 3/4. Leer lassen, solange ungetestet.
ALPHA_VANTAGE_API_KEY=""
FINNHUB_API_KEY=""
FMP_API_KEY=""
