# Passwort fuer die Oberflaeche. Ohne diese Variable ist in der
# Produktion keine Seite erreichbar (bewusst: lieber geschlossen als
# unbemerkt offen). Lang und zufaellig waehlen, es gibt keine
# Sperre nach zu vielen Fehlversuchen.
# Ein Wechsel macht alle bestehenden Anmeldungen ungueltig.
APP_PASSWORD=""

# SEC verlangt einen aussagekraeftigen User-Agent mit Kontakt-E-Mail.
# Ohne ihn antwortet EDGAR mit HTTP 403.
SEC_USER_AGENT="ticker-alerts/0.1 (kontakt@example.com)"

# Neon Postgres. Ohne diese Variable schreibt /api/refresh nicht und
# die Oberflaeche zeigt den letzten Snapshot beziehungsweise Demodaten.
DATABASE_URL=""

# Kurse. Ohne Schluessel faellt der Abruf auf Stooq zurueck, das aber
# geteilte Cloud-Adressen sperrt (gemessen, siehe docs/decisions.md).
TWELVEDATA_API_KEY=""

# Nur fuer Vercel Cron: erlaubt dem Zeitplan den Zugriff auf
# /api/refresh ohne Anmeldung. Nicht gesetzt heisst: kein Cron-Zugang.
CRON_SECRET=""

# Telegram, fuer Analysten-Push. Ohne beides erscheinen neue Meldungen
# nur in der Oberflaeche. Secrets in GitHub Actions, nicht ins Repository.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Earnings-Kalender und Ratings, ab Slice 3/4. Leer lassen, solange ungetestet.
ALPHA_VANTAGE_API_KEY=""
FINNHUB_API_KEY=""
FMP_API_KEY=""
